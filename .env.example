# Environment Configuration
NODE_ENV=development
SOLANA_NETWORK=devnet

# API Keys (required)
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_DEVNET_RPC=https://devnet.helius-rpc.com/?api-key=
HELIUS_MAINNET_RPC=https://mainnet.helius-rpc.com/?api-key=

# Wallet Configuration
WALLET_PRIVATE_KEY_DEV=your_devnet_private_key_base58
WALLET_PRIVATE_KEY=your_mainnet_private_key_base58

# Risk Parameters
MAX_POSITION_SIZE=0.50
MAX_VOLATILITY=0.30
MAX_DRAWDOWN=0.20
REBALANCE_THRESHOLD=0.05
MIN_APY_THRESHOLD=3.0
MIN_SOL_BALANCE=0.05
MAX_SLIPPAGE_BPS=50

# API Configuration
API_PORT=3000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info
