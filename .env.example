# Sentience Environment Configuration

# Solana Configuration
SOLANA_ENV=devnet
HELIUS_API_KEY=your_helius_api_key_here
RPC_ENDPOINT=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Wallet Configuration
