MAX_VOLATILITY=0.30
MAX_DRAWDOWN=0.20
MIN_LIQUIDITY=1000

# Strategy Parameters
REBALANCE_THRESHOLD=0.05
STRATEGY_INTERVAL_MINUTES=5

